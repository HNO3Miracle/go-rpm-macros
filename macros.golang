#
# Golang macros
#

%__go /usr/bin/go
%gopath /usr/share/gocode
%go_sys_gopath %{gopath}/src

# Generate metadata consumed by the RPM Go file attribute generator. This can
# be called from a custom %install with an explicit import path and version:
#   %go_generate_provides -i example.org/project -v %{version}
%go_generate_provides(i:v:) %{expand:\
  ( \
    _go_import_path="%{-i*}" ; \
    _go_version="%{-v*}" ; \
    [ -n "$_go_import_path" ] || _go_import_path="%{go_import_path}" ; \
    [ -n "$_go_version" ] || _go_version="%{version}" ; \
    _go_source_root="%{buildroot}%{go_sys_gopath}" ; \
    if [ ! -d "$_go_source_root/$_go_import_path" ]; then \
      echo "Go import root is not installed: $_go_import_path" >&2 ; \
      exit 1 ; \
    fi ; \
    cd "$_go_source_root/$_go_import_path" || exit 1 ; \
    export GOPATH=%{buildroot}%{gopath} GO111MODULE=off ; \
    _go_list_dir=$(mktemp -d) || exit 1 ; \
    trap 'rm -rf "$_go_list_dir"' EXIT ; \
    _go_list_file="$_go_list_dir/list" ; \
    _go_package_file="$_go_list_dir/packages" ; \
    : >"$_go_package_file" ; \
    if %__go list -e -f '{{if .Error}}error|{{.ImportPath}}{{else if eq .Name "main"}}main|{{.ImportPath}}{{else if not (or .GoFiles .CgoFiles .SFiles)}}nosource|{{.ImportPath}}{{else}}package|{{.ImportPath}}{{end}}' "$_go_import_path/..." >"$_go_list_file" ; then \
      _go_list_rc=0 ; \
    else \
      _go_list_rc=$? ; \
    fi ; \
    _go_packages=0 ; \
    _go_markers=0 ; \
    _go_skipped_main=0 ; \
    _go_skipped_nosource=0 ; \
    _go_skipped_examples=0 ; \
    _go_errors=0 ; \
    while IFS='|' read -r _go_kind _go_package _go_error; do \
      case "$_go_kind" in \
        error) \
          _go_errors=$((_go_errors + 1)) ; \
          echo "go-provides: package error: $_go_package" >&2 ; \
          ;; \
        package) \
          _go_packages=$((_go_packages + 1)) ; \
          case "/$_go_package/" in \
            */example/*|*/examples/*) \
              _go_skipped_examples=$((_go_skipped_examples + 1)) ; \
              ;; \
            *) \
              echo "$_go_package" >>"$_go_package_file" ; \
              _go_markers=$((_go_markers + 1)) ; \
              ;; \
          esac ; \
          ;; \
        main) _go_skipped_main=$((_go_skipped_main + 1)) ;; \
        nosource) _go_skipped_nosource=$((_go_skipped_nosource + 1)) ;; \
      esac ; \
    done <"$_go_list_file" ; \
    echo "go-provides: packages=$_go_packages markers=$_go_markers skipped-main=$_go_skipped_main skipped-no-source=$_go_skipped_nosource skipped-examples=$_go_skipped_examples errors=$_go_errors" >&2 ; \
    if [ "$_go_list_rc" -ne 0 ]; then \
      echo "go-provides: go list failed for $_go_import_path (rc=$_go_list_rc)" >&2 ; \
      exit "$_go_list_rc" ; \
    fi ; \
    if [ "$_go_errors" -ne 0 ]; then \
      echo "go-provides: skipped $_go_errors packages with errors" >&2 ; \
    fi ; \
    while IFS= read -r _go_package; do \
      printf 'version:%s\n' "$_go_version" > "$_go_source_root/$_go_package/.goipath" || exit 1 ; \
    done <"$_go_package_file" ; \
  ) \
}

#
# Common flags
#
%go_common \
  export GO111MODULE=off \
  export GOPATH=%{_builddir}/go:%{_datadir}/gocode \
%{nil}

#
# Build flags
#
%go_build_flags_default -v

#
# Test flags
#
%go_test_flags_default -v
# TODO: It's broken, will append annoying "--".
%go_test_flags(-) %{expand:%{shrink:%{go_test_flags_default} %**}}

#
# BuildSystem flags
#
%go_prep \
  %__mkdir -p %{_builddir}/go/src/%{go_import_path} \
  %__cp -a . %{_builddir}/go/src/%{go_import_path} \
%{nil}
